generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(cuid())
  nom       String
  email     String?  @unique
  telephone String?  @unique
  quartier  String
  password  String
  role      String   @default("CLIENT")
  createdAt DateTime @default(now())

  commandes  Commande[]
  avis       Avis[]
  producteur Producteur?
}

model Producteur {
  id          String   @id @default(cuid())
  userId      String   @unique
  nomBoutique String
  province    String
  verifie     Boolean  @default(false)
  createdAt   DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id])
  produits Produit[]
}

model Produit {
  id           String   @id @default(cuid())
  producteurId String
  nom          String
  type         String
  prix         Float
  stock        Int
  image        String?
  description  String
  actif        Boolean  @default(true)
  createdAt    DateTime @default(now())

  producteur    Producteur     @relation(fields: [producteurId], references: [id])
  commandeItems CommandeItem[]
  avis          Avis[]
}

model Commande {
  id              String   @id @default(cuid())
  userId          String
  total           Float
  statut          String   @default("EN_ATTENTE")
  nom             String
  telephone       String
  province        String
  ville           String
  adresse         String
  methodePaiement String
  createdAt       DateTime @default(now())

  user  User           @relation(fields: [userId], references: [id])
  items CommandeItem[]
}

model CommandeItem {
  id         String @id @default(cuid())
  commandeId String
  produitId  String
  quantite   Int
  prix       Float

  commande Commande @relation(fields: [commandeId], references: [id])
  produit  Produit  @relation(fields: [produitId], references: [id])
}

model Avis {
  id          String   @id @default(cuid())
  userId      String
  produitId   String
  note        Int
  commentaire String
  createdAt   DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  produit Produit @relation(fields: [produitId], references: [id])
}